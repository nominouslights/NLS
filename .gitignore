# OS
.DS_Store

# Node (Dispatcher)
node_modules/
.next/
next-env.d.ts

# .NET (Backend)
bin/
obj/
TestResults/

# Local-only Claude settings
.claude/settings.local.json
**/.claude/settings.local.json

# Per-machine Claude scratch state (code-map pending-changes log)
.claude/state/

# Env / secrets
.env
.env.*
CREDENTIALS.local.md

# Filled-in Kubernetes Secrets. Only the template (k8s/base/secret.example.yaml) is tracked;
# real connection strings and signing keys are applied out of band.
k8s/**/secret.yaml
k8s/**/secrets.yaml

# AppHost.cs carries local-dev/orchestration secrets (DB connection string, JWT signing key,
# RabbitMQ credentials) as literal WithEnvironment(...) values — never commit it. A fresh
# clone needs a local copy recreated by hand; see CLAUDE.md.
AppHost/NorthernLink.AppHost/AppHost.cs

# launchSettings.json now also carries the DigitalOcean Postgres connection string (there's no
# local Postgres to fall back to) — same reasoning as AppHost.cs above.
Backend/src/Api/NorthernLink.Api/Properties/launchSettings.json

# The AppHost's own launchSettings.json is per-machine local dev state too — same category as
# the two above, and it was never tracked. Naming it keeps `git status` quiet and keeps the
# code map stable: the map lists untracked-but-unignored files, so this one made the AppHost
# section read as stale on any machine that had run the orchestrator.
AppHost/NorthernLink.AppHost/Properties/launchSettings.json
