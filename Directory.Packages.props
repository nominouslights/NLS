<Project>

  <PropertyGroup>
    <!-- Every PackageVersion below is also a floor for transitive dependencies. Turned on for the
         System.Security.Cryptography.Pkcs pin (Security section): the vulnerable 9.0.0 reaches
         every module through Microsoft.EntityFrameworkCore.Design's MSBuild/Roslyn chain, and a
         central pin is one line here instead of a direct reference in eleven csproj files. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Abstractions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Auth">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup Label="Messaging">
    <PackageVersion Include="RabbitMQ.Client" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup Label="Aspire (local dev orchestration)">
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.JavaScript" Version="13.4.6" />
  </ItemGroup>

  <ItemGroup Label="Object Storage">
    <PackageVersion Include="AWSSDK.S3" Version="3.7.400" />
  </ItemGroup>

  <ItemGroup Label="Content sanitization">
    <!-- Vetted allowlist HTML sanitizer (Ganss, namespace Ganss.Xss) — used by the Notifications
         module to strip script/event-handler/js-URL injection from stored email-template bodies. -->
    <PackageVersion Include="HtmlSanitizer" Version="9.2.995" />
  </ItemGroup>

  <ItemGroup Label="PDF generation">
    <!-- QuestPDF (Community license) — used by the Notifications module to render the
         pickup-email report PDF attached to ContractCrew report emails. -->
    <PackageVersion Include="QuestPDF" Version="2026.7.3" />
  </ItemGroup>

  <ItemGroup Label="Spreadsheet import">
    <!-- ExcelDataReader (MIT) — used by the Trips module to read the Bookeo booking-report
         export: legacy Excel 97 .xls (BIFF8) and .xlsx. Read-only; nothing writes a workbook. -->
    <PackageVersion Include="ExcelDataReader" Version="3.9.0" />
  </ItemGroup>

  <ItemGroup Label="Security (transitive pins)">
    <!-- Not referenced directly by any project — a transitive pin. Microsoft.EntityFrameworkCore.Design
         10.0.0 → Microsoft.CodeAnalysis.Workspaces.MSBuild 4.14.0 → Microsoft.Build.Tasks.Core
         17.14.28 pulls Pkcs 9.0.0, which carries GHSA-846f-f764-76mx (high, CVE-2026-84008) and
         GHSA-2fmv-rv2c-59x7 (moderate, CVE-2026-70162), both .NET DoS, published 2026-10-13.
         With TreatWarningsAsErrors the NU1902/NU1903 audit warnings fail restore outright.
         9.0.21 is the first patched 9.0.x. Bumping EF Design to 10.0.13 instead would drag EF Core
         Relational (and so every module's EF Core) to 10.0.13 — a larger change than this pin.
         Drop this entry once EF Design's own chain resolves a patched Pkcs. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.0.2" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- 4.14.0, not 4.13.0: 4.13.0 pulls SSH.NET 2025.1.0 transitively, which carries a high
         severity advisory (GHSA-q939-rpr3-3284, ScpClient arbitrary file write). With
         TreatWarningsAsErrors the NU1903 audit warning fails restore outright. 4.14.0 depends on
         SSH.NET 2026.0.0 — the advisory's first patched version — so the fix is a bump rather
         than an audit suppression or a transitive pin. -->
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.14.0" />
  </ItemGroup>

</Project>
