<Project Sdk="Microsoft.NET.Sdk">

  <!-- End-to-end tests for Budgeting persistence against a real Postgres in a Testcontainers
       container, connecting as a NON-superuser role so Row-Level Security is actually enforced.
       What lives here is what the in-memory fakes of NorthernLink.Budgeting.Tests cannot see:
       EF Core's change tracker (owned JSON vendor shares), query translation, the projection
       worker, and the hand-written SQL of migrations. Requires Docker. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Budgeting\NorthernLink.Budgeting.csproj" />
  </ItemGroup>

</Project>
