<Project Sdk="Microsoft.NET.Sdk">

  <!-- Unit tests for the Budgeting library's Domain and Application layers — in-memory
       fakes, no EF/Postgres, no HTTP. Infrastructure is exercised end-to-end against the
       real database instead, with one deliberate exception: ActualTransactionSchemaTests
       builds the EF model (no connection is opened) to assert the unique external-reference
       index, because "a re-import cannot double-count" is a guarantee that lives only in the
       schema and no code path can be asked about it. -->

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Budgeting\NorthernLink.Budgeting.csproj" />
  </ItemGroup>

</Project>
