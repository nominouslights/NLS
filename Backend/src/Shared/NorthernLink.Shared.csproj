<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one library every domain library shares: kernel base types (Entity, Result, …),
       the command/query dispatcher, the integration event bus, and tenancy plumbing.
       Extracting a domain library into its own microservice later means copying that
       library plus this one (or publishing this as a NuGet package).

       Cross-domain communication is integration-events-only: event records live under
       IntegrationEvents/<DomainName>/ here, names end in "IntegrationEvent", and the
       routing key convention (<domain>.<event-name>) derives from that namespace.
       Keep event types small, serializable, and stable — every domain library is
       allowed to depend on them. -->

  <ItemGroup>
    <InternalsVisibleTo Include="NorthernLink.Shared.Tests" />
    <!-- Drives ProjectionWorker.ProcessOnceAsync / ProjectionRegistryBuilder.Build directly
         (the projection worker's process-once entry point is internal by design). -->
    <InternalsVisibleTo Include="NorthernLink.Fleet.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

</Project>
