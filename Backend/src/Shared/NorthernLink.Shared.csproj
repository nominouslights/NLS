<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one library every domain library shares: kernel base types (Entity, Result, …),
       the command/query dispatcher, the integration event bus, and tenancy plumbing.
       Extracting a domain library into its own microservice later means copying that
       library plus this one (or publishing this as a NuGet package).

       Cross-domain communication is integration-events-only: event records live under
       IntegrationEvents/<DomainName>/ here, names end in "IntegrationEvent", and the
       routing key convention (<domain>.<event-name>) derives from that namespace.
       Keep event types small, serializable, and stable — every domain library is
       allowed to depend on them. -->

  <ItemGroup>
    <InternalsVisibleTo Include="NorthernLink.Shared.Tests" />
    <!-- Drives ProjectionWorker.ProcessOnceAsync / ProjectionRegistryBuilder.Build directly
         (the projection worker's process-once entry point is internal by design). -->
    <InternalsVisibleTo Include="NorthernLink.Fleet.IntegrationTests" />
    <InternalsVisibleTo Include="NorthernLink.Drivers.IntegrationTests" />
    <InternalsVisibleTo Include="NorthernLink.Budgeting.IntegrationTests" />
    <!-- Drives OutboxPollingConsumer.ProcessOnceAsync directly (internal by design, like
         the projection worker's) and builds IntegrationEventSubscriptions in isolation. -->
    <InternalsVisibleTo Include="NorthernLink.Trips.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!-- Direct, so every module and test project resolves Relational at the same central version
         as EF Core and EF Design. The Npgsql provider only sets a floor on Relational, which lags
         EF's; without this reference, projects that don't reference EF Design (PrivateAssets=all,
         so it never flows) compile against the provider's older floor and fail CS1705 against
         modules built with the newer one. Keep it for as long as the provider's floor lags. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="RabbitMQ.Client" />
    <PackageReference Include="AWSSDK.S3" />
  </ItemGroup>

</Project>
