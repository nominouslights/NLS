<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The gateway: composition root for every domain library. References Shared plus one
       library per domain — for DI registration and endpoint composition ONLY. Endpoint
       code lives in the domain libraries, never here. -->

  <ItemGroup>
    <ProjectReference Include="..\..\Shared\NorthernLink.Shared.csproj" />
    <ProjectReference Include="..\..\Identity\NorthernLink.Identity.csproj" />
    <ProjectReference Include="..\..\Trips\NorthernLink.Trips.csproj" />
    <ProjectReference Include="..\..\Drivers\NorthernLink.Drivers.csproj" />
    <ProjectReference Include="..\..\Fleet\NorthernLink.Fleet.csproj" />
    <ProjectReference Include="..\..\Clients\NorthernLink.Clients.csproj" />
    <ProjectReference Include="..\..\Billing\NorthernLink.Billing.csproj" />
    <ProjectReference Include="..\..\Budgeting\NorthernLink.Budgeting.csproj" />
    <ProjectReference Include="..\..\Incidents\NorthernLink.Incidents.csproj" />
    <ProjectReference Include="..\..\Notifications\NorthernLink.Notifications.csproj" />
    <ProjectReference Include="..\..\Grocery\NorthernLink.Grocery.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <!-- Design-time only: `dotnet ef` needs it in the startup project, the running app does not.
         PrivateAssets keeps the Roslyn design-time assemblies out of the published container. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
