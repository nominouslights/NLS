<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Notifications domain library: Domain/, Application/, and Infrastructure/ layers in one
       assembly, composed by the API gateway. References NorthernLink.Shared and nothing
       else internal — never another domain library; cross-domain communication is
       integration-events-only. Extracting this into its own microservice = copy this
       library (endpoints included) plus Shared. -->

  <ItemGroup>
    <ProjectReference Include="..\Shared\NorthernLink.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimal-API endpoint mapping lives in the library, not the host. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vetted allowlist HTML sanitizer for stored email-template bodies (Ganss.Xss). -->
    <PackageReference Include="HtmlSanitizer" />
    <!-- QuestPDF (Community license) — renders the pickup-email report PDF attachment. -->
    <PackageReference Include="QuestPDF" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
